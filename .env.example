# gemini | groq | fake (FakeLLM: offline, answers a few known phrases)
LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq: https://console.groq.com/keys (free tier, no card)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Embeddings: sentence-transformers (local CPU, no key) | fake (tests). The model must give 384-d
# vectors (the pgvector column and the Qdrant collection are 384-d).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_COLLECTION=products

# Postgres (+pgvector). docker compose always uses its own postgres service; host/port are for
# running outside Docker.
POSTGRES_USER=products
POSTGRES_PASSWORD=products
POSTGRES_DB=products
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Outside Docker only; docker compose always uses the qdrant/redis services.
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Host ports published by docker compose (change if already taken)
API_PORT=8000
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
REDIS_HOST_PORT=6379
